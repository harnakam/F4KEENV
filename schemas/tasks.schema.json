{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f4keenv.invalid/schemas/tasks.schema.json",
  "type": "object",
  "required": [
    "id",
    "provider_id",
    "status",
    "priority",
    "queries",
    "evidence_ids",
    "reason"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "pending",
        "running",
        "complete",
        "failed"
      ]
    },
    "priority": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "queries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "query"
        ],
        "properties": {
          "kind": {
            "enum": [
              "concrete",
              "abstract",
              "related"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reason": {
      "type": "string",
      "minLength": 1
    }
  }
}
