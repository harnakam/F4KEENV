{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://f4keenv.invalid/schemas/credentials.schema.json",
  "type": "object",
  "required": [
    "id",
    "provider_id",
    "credential_type",
    "variant",
    "auth",
    "serialization",
    "issuance",
    "confidence",
    "evidence_kind",
    "evidence_ids",
    "synthetic_capability",
    "detector_refs",
    "operations"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "provider_id": {
      "type": "string",
      "minLength": 1
    },
    "credential_type": {
      "type": "string",
      "minLength": 1
    },
    "variant": {
      "type": "string",
      "minLength": 1
    },
    "auth": {
      "type": "object",
      "required": [
        "type",
        "location"
      ],
      "properties": {
        "type": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "serialization": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "unknown",
            "detector_observed",
            "approximate",
            "officially_documented"
          ]
        }
      }
    },
    "issuance": {
      "type": "object",
      "required": [
        "method",
        "algorithm"
      ],
      "properties": {
        "method": {
          "type": "string",
          "minLength": 1
        },
        "algorithm": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_kind": {
      "type": "string",
      "minLength": 1
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "synthetic_capability": {
      "enum": [
        "unknown",
        "local_only",
        "public_safe"
      ]
    },
    "detector_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "operations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  }
}
